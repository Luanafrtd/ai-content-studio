# Local/demo default: SQLite, zero config.
# For production, point this at Postgres instead (Vercel Postgres, Neon, Supabase, etc.)
# and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET="replace-with-a-strong-random-secret"

# Base URL of the app (used by Auth.js in some environments)
NEXTAUTH_URL="http://localhost:3000"

# Public site URL used for metadataBase (canonical/OG tags). Optional locally
# — defaults to http://localhost:3000. Set to your real domain in production.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI generation (all optional) -------------------------------------
# Quill ships with a deterministic mock AI provider by default, so the app
# runs and demos fully with NONE of the keys below set. Set either key to
# switch live generation over to the real model, with no code changes —
# see src/lib/ai/index.ts. Anthropic takes priority if both are set.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# --- Rate limiting (optional) ------------------------------------------
# The /api/generate rate limit (30 req/hour/user) uses an in-memory
# counter by default — fine for local dev, but per-instance on serverless,
# so it doesn't hold up across cold starts in production. Add an Upstash
# Redis database (free tier) via Vercel's Storage tab, or upstash.com
# directly, to switch to a real distributed limiter — no code changes.
# See src/lib/ai/rate-limiter.ts.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
